{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "jsx": "react-native",
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@ui": [
        "../../packages/ui/src/kit/contracts/index.ts"
      ],
      "@ui/*": [
        "../../packages/ui/src/kit/contracts/*"
      ],
      "@notesnook/ui-kit/*": [
        "../../packages/ui/src/kit/*"
      ],
      "@platform": [
        "./src/platform/index.ts"
      ],
      "@platform/*": [
        "./src/platform/*"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/ui/src/kit/contracts",
    "../../packages/ui/src/kit/desktop",
    "../../packages/ui/src/kit/shared",
    "index.js",
    "react-native-gpui-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "desktop",
    "src/targets/web"
  ]
}
