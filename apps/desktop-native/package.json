{
  "name": "@notesnook/desktop-native",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-or-later",
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "build": "node scripts/with-hermes.mjs react-native run-desktop --release --no-launch",
    "desktop": "node scripts/with-hermes.mjs react-native run-desktop",
    "tsc": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test:e2e": "RN_GPUI_TEST_BUNDLE=$PWD/desktop/build/index.bundle RN_GPUI_TEST_BINARY=$PWD/desktop/build/target/debug/react-native-gpui--notesnook-desktop-native vitest run --config desktop/vitest.e2e.config.ts",
    "build:test": "CARGO_INCREMENTAL=0 node scripts/with-hermes.mjs react-native-gpui run-desktop --features test-driver --no-launch --port 8171",
    "clean:build": "node scripts/clean-build.mjs",
    "bundle": "react-native bundle --platform desktop --entry-file index.js --bundle-output desktop/build/index.bundle --assets-dest desktop/build/assets --dev true",
    "parity": "node tools/parity/run.mjs",
    "check:testids": "node tools/check-testids.mjs",
    "gen:assets": "node tools/gen-assets.mjs",
    "tsc:web": "tsc --noEmit -p src/targets/web/tsconfig.json",
    "test:unit": "vitest run --config vitest.unit.config.ts"
  },
