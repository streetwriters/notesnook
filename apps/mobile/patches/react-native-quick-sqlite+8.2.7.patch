+static const lxb_char_t *
+lxb_url_path_part_by_index(const lxb_url_t *url, size_t index,
+                           size_t *out_length)
+{
+    size_t i, length, begin;
+    const lxb_char_t *data;
+
+    data = url->path.str.data;
+    length = url->path.str.length;
+
+    i = 0;
+    begin = 0;
+
+    while (i < length) {
+        if (data[i] == '/') {
+            if (index == 0) {
+                *out_length = i - begin;
+                return &data[begin];
+            }
+
+            index -= 1;
+            begin = i + 1;
+        }
+
+        i += 1;
+    }
+
+    *out_length = 0;
+
+    return NULL;
+}
