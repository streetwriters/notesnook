+SQLITE_PRIVATE void
+sqlite3mcPadPassword(char* password, int pswdlen, unsigned char pswd[32])
+{
+  int j;
+  int p = 0;
+  int m = pswdlen;
+  if (m > 32) m = 32;
+
+  for (j = 0; j < m; j++)
+  {
+    pswd[p++] = (unsigned char) password[j];
+  }
+  for (j = 0; p < 32 && j < 32; j++)
+  {
+    pswd[p++] = padding[j];
+  }
+}
