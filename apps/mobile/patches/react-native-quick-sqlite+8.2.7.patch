+lxb_inline bool
+lxb_url_is_noncharacter(lxb_codepoint_t cp)
+{
+    if (cp >= 0xFDD0 && cp <= 0xFDEF) {
+        return true;
+    }
+
+    switch (cp) {
+        case 0xFFFE:
+        case 0xFFFF:
+        case 0x1FFFE:
+        case 0x1FFFF:
+        case 0x2FFFE:
+        case 0x2FFFF:
+        case 0x3FFFE:
+        case 0x3FFFF:
+        case 0x4FFFE:
+        case 0x4FFFF:
+        case 0x5FFFE:
+        case 0x5FFFF:
+        case 0x6FFFE:
+        case 0x6FFFF:
+        case 0x7FFFE:
+        case 0x7FFFF:
+        case 0x8FFFE:
+        case 0x8FFFF:
+        case 0x9FFFE:
+        case 0x9FFFF:
+        case 0xAFFFE:
+        case 0xAFFFF:
+        case 0xBFFFE:
+        case 0xBFFFF:
+        case 0xCFFFE:
+        case 0xCFFFF:
+        case 0xDFFFE:
+        case 0xDFFFF:
+        case 0xEFFFE:
+        case 0xEFFFF:
+        case 0xFFFFE:
+        case 0xFFFFF:
+        case 0x10FFFE:
+        case 0x10FFFF:
+            return true;
+
+        default:
+            break;
+    }
+
+    return false;
+}
+
+lxb_inline bool
+lxb_url_is_url_codepoint(lxb_codepoint_t cp)
+{
+    if (cp >= 0x00A0 && cp <= 0x1FFFFF) {
+        /* Leading and trailing surrogate. */
+        if ((cp >= 0xD800 && cp <= 0xDFFF)) {
+            return false;
+        }
+
+        return !(cp > 0x10FFFF || lxb_url_is_noncharacter(cp));
+    }
+
+    return lxb_url_codepoint_alphanumeric[(lxb_char_t) cp] != 0xFF;
+}
