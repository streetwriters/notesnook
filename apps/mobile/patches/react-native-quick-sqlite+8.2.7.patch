+        return lxb_unicode_entry_decomposition_hangul(uc, buf, end, cp);
+    }
+    else {
+        lxb_unicode_check_buf(uc, buf, end, 1);
+        if (*buf == NULL) {
+            return NULL;
+        }
+
+        p = *buf;
+
+        p->cp = cp;
+        p->ccc = entry->ccc;
+
+        p += 1;
+    }
+
+    return p;
+}
