+        dp = uc->decomposition(uc, cp, &p, &buf_end);
+        if (dp == NULL) {
+            lxb_unicode_normalizer_clean(uc);
+            return LXB_STATUS_ERROR_MEMORY_ALLOCATION;
+        }
