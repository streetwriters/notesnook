+}
+
+const lxb_char_t *
+lxb_html_token_attr_name(lxb_html_token_attr_t *attr, size_t *length)
+{
+    if (attr->name == NULL) {
+        if (length != NULL) {
+            *length = 0;
+        }
+
+        return NULL;
+    }
+
+    if (length != NULL) {
+        *length = attr->name->entry.length;
+    }
+
+    return lexbor_hash_entry_str(&attr->name->entry);
+}
