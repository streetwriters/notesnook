+                starter->cp = centry->cp;
+                starter->ccc = entry->ccc;
+
+                p->cp = LXB_ENCODING_ERROR_CODEPOINT;
+                p->ccc = 0;
+            }
+        }
+        else {
+            cp = lxb_unicode_entry_compose_hangul(starter->cp, p->cp);
+
+            if (cp != LXB_ENCODING_ERROR_CODEPOINT) {
+                starter->cp = cp;
+                starter->ccc = 0;
+
+                p->cp = LXB_ENCODING_ERROR_CODEPOINT;
+                p->ccc = 0;
+            }
+        }
