+    if (*pos == '\0') {
+        pos = data + (pos - tkz->markup);
+
+        lxb_html_tokenizer_state_token_attr_set_name_end(tkz, pos);
+
+        attr_data = lxb_dom_attr_data_by_id(tkz->attrs,
+                                            LXB_DOM_ATTR_PUBLIC);
