+    while (p < end) {
+        if (p->cp == LXB_ENCODING_ERROR_CODEPOINT) {
+            p += 1;
+            continue;
+        }
+
+        if (p[-1].ccc != 0 && p[-1].ccc >= p->ccc) {
+            p += 1;
+            continue;
+        }
+
+        centry = lxb_unicode_compose_entry(starter->cp, p->cp);
+
+        if (centry != NULL) {
+            if (!centry->exclusion) {
+                entry = lxb_unicode_normalization_entry_by_cp(centry->cp);
