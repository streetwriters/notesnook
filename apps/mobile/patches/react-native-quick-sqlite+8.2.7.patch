+
+/*
+** Configuration parameters for "aes128cbc"
+**
+** - legacy mode : compatibility with first version (page 1 encrypted)
+**                 possible values:  1 = yes, 0 = no (default)
+*/
+
+#ifdef WXSQLITE3_USE_OLD_ENCRYPTION_SCHEME
