+/*
+** Free the encryption data structure associated with a pager instance.
+** (called from the modified code in pager.c) 
+*/
+SQLITE_PRIVATE void
+sqlite3mcCodecFree(void *pCodecArg)
+{
+  if (pCodecArg)
+  {
+    sqlite3mcCodecTerm(pCodecArg);
+    sqlite3_free(pCodecArg);
+    pCodecArg = NULL;
+  }
+}
