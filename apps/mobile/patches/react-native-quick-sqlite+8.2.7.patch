+
+#ifndef LEXBOR_HTML_TOKENIZER_H
+#define LEXBOR_HTML_TOKENIZER_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#include "lexbor/core/sbst.h"
