+}
+
+lxb_status_t
+lxb_unicode_idna_init(lxb_unicode_idna_t *idna)
+{
+    if (idna == NULL) {
+        return LXB_STATUS_ERROR_OBJECT_IS_NULL;
+    }
+
+    return lxb_unicode_normalizer_init(&idna->normalizer, LXB_UNICODE_NFC);
+}
