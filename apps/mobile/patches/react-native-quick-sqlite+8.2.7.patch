+#define lxb_url_parse_return(data, buf, status)                               \
+    do {                                                                      \
+        if ((buf) != (data)) {                                                \
+            lexbor_free((lxb_char_t *) (buf));                                \
+        }                                                                     \
+        return (status);                                                      \
+    }                                                                         \
+    while (false)
