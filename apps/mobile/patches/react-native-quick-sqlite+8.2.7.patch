+/*
+ * U+002C COMMA (,)
+ */
+const lxb_char_t *
+lxb_css_syntax_state_comma(lxb_css_syntax_tokenizer_t *tkz,
+                           lxb_css_syntax_token_t *token,
+                           const lxb_char_t *data, const lxb_char_t *end)
+{
+    token->type = LXB_CSS_SYNTAX_TOKEN_COMMA;
+    return data + 1;
