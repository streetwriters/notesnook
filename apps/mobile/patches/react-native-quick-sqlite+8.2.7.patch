+      const char *start = p;
+      while (*p >= '0' && *p <= '9') p++;
+      size_t len = p - start;
+      if (len < 10) result.append(10 - len, '0');
+      result.append(start, len);
+    } else {
+      result.push_back(*p);
+      p++;
+    }
+  }
+  sqlite3_result_text(context, result.c_str(), static_cast<int>(result.length()), SQLITE_TRANSIENT);
+}
