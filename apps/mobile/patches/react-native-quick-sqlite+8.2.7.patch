diff --git a/node_modules/react-native-quick-sqlite/lexbor/html/interfaces/document.c b/node_modules/react-native-quick-sqlite/lexbor/html/interfaces/document.c
new file mode 100755
index 0000000..48f8403
--- /dev/null
