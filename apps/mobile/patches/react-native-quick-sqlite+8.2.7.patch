+lxb_html_token_attr_clean(lxb_html_token_attr_t *attr)
+{
+    memset(attr, 0, sizeof(lxb_html_token_attr_t));
+}
+
+lxb_html_token_attr_t *
+lxb_html_token_attr_destroy(lxb_html_token_attr_t *attr, lexbor_dobject_t *dobj)
