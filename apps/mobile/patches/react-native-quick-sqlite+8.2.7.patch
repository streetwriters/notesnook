+  int rc = 0;
+  int i;
+  int j;
+  int numberOfRounds = (bits == 128) ? 10 : (bits == 192) ? 12 : (bits == 256) ? 14 : 0;
+  int keyWords = bits / 32;  
+  int schedWords = (numberOfRounds + 1) * 4;
