+SQLITE_PRIVATE int
+sqlite3mcGetGlobalCipherCount()
+{
+  int cipherCount = 0;
+  sqlite3_mutex_enter(sqlite3_mutex_alloc(SQLITE_MUTEX_STATIC_MAIN));
+  cipherCount = globalCipherCount;
+  sqlite3_mutex_leave(sqlite3_mutex_alloc(SQLITE_MUTEX_STATIC_MAIN));
+  return cipherCount;
+}
