+
+LXB_API void
+lxb_html_tokenizer_clean(lxb_html_tokenizer_t *tkz);
+
+LXB_API lxb_html_tokenizer_t *
+lxb_html_tokenizer_destroy(lxb_html_tokenizer_t *tkz);
+
