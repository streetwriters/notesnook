+                                                            &tmp_str, url->mraw,
+                                                            LXB_URL_MAP_C0, false);
+                if (status != LXB_STATUS_OK) {
+                    lxb_url_parse_return(orig_data, buf, status);
+                }
+
+                status = lxb_url_path_list_push(url, &tmp_str);
+
+                lxb_url_parse_return(orig_data, buf, status);
+            }
+
+            c = *p;
+
+            if (c == '#' || c == '?') {
+                tmp_str.data = NULL;
+
+                status = lxb_url_percent_encode_after_utf_8(begin, p,
+                                                            &tmp_str, url->mraw,
+                                                            LXB_URL_MAP_C0, false);
+                if (status != LXB_STATUS_OK) {
+                    lxb_url_parse_return(orig_data, buf, status);
+                }
+
+                status = lxb_url_path_list_push(url, &tmp_str);
+                if (status != LXB_STATUS_OK) {
+                    lxb_url_parse_return(orig_data, buf, status);
+                }
+
