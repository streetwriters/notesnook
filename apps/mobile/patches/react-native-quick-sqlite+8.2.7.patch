+static void rightFunc(sqlite3_context *context, int argc, sqlite3_value **argv){
+  int l=0;
+  int c=0;
+  int cc=0;
+  const char *z;
+  const char *zt;
+  const char *ze;
+  char *rz;
+
+  assert( argc==2);
+
+  if( SQLITE_NULL == sqlite3_value_type(argv[0]) || SQLITE_NULL == sqlite3_value_type(argv[1])){
