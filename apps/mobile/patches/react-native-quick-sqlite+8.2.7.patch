+                status = lxb_url_log_append(parser, p,
+                                   LXB_URL_ERROR_TYPE_INVALID_REVERSE_SOLIDUS);
+                if (status != LXB_STATUS_OK) {
+                    lxb_url_parse_return(orig_data, buf, status);
