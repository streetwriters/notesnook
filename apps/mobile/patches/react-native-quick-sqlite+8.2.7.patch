+                                                url->mraw, opt);
+                    if (status != LXB_STATUS_OK) {
+                        lxb_url_parse_return(orig_data, buf, status);
+                    }
+
+                    p += 1;
+
+                    state = LXB_URL_STATE_PORT_STATE;
+                    goto again;
+
+                case '[':
