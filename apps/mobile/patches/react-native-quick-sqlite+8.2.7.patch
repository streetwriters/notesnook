+
+static lxb_status_t
+lxb_dom_element_style_serialize_cb(lexbor_avl_t *avl, lexbor_avl_node_t **root,
+                                   lexbor_avl_node_t *node, void *ctx);
+
+static lxb_status_t
+lxb_dom_element_style_serialize_str_cb(const lxb_char_t *data,
