+        }
+
+        p = *buf;
+
+        for (i = 0; i < length; i++) {
+            entry = lxb_unicode_normalization_entry_by_cp(mapping[i]);
+
+            p->cp = mapping[i];
+            p->ccc = entry->ccc;
+
+            p += 1;
+        }
+    }
