+{
+  int value = -1;
+  for (; cipherParams->m_name[0] != 0; ++cipherParams)
+  {
+    if (sqlite3_stricmp(paramName, cipherParams->m_name) == 0) break;
+  }
+  if (cipherParams->m_name[0] != 0)
+  {
+    value = cipherParams->m_value;
+    cipherParams->m_value = cipherParams->m_default;
+  }
+  return value;
