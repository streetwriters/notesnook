+  { "legacy",            AES128_LEGACY_DEFAULT, AES128_LEGACY_DEFAULT, 0, 1 },
+  { "legacy_page_size",  0,                     0,                     0, SQLITE_MAX_PAGE_SIZE },
+  CIPHER_PARAMS_SENTINEL
