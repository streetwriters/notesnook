+lxb_css_selectors_state_relative_wo_root(lxb_css_parser_t *parser,
+                                         const lxb_css_syntax_token_t *token,
+                                         void *ctx)
+{
+    return lxb_css_selectors_state_relative_handler(parser, token, ctx, false,
+                                                    false);
