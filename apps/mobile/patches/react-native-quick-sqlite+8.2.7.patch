+      }
+
+      sched[i] = sched[i - keyWords] ^ temp;
+    }
+  }
+
+  /* Convert key schedule words into uint8x16_t vectors */
+  for (j = 0; j <= numberOfRounds; j++)
+  {
+    keyData[j] = vreinterpretq_u8_u32(vld1q_u32(sched + 4*j));
+  }
+
+  return rc;
+}
