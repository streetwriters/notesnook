+        selectors->parent = NULL;
+        selectors->combinator = LXB_CSS_SELECTOR_COMBINATOR_DESCENDANT;
+        selectors->comb_default = LXB_CSS_SELECTOR_COMBINATOR_DESCENDANT;
+        selectors->error = 0;
+        selectors->err_in_function = false;
+        selectors->failed = false;
+    }
+}
