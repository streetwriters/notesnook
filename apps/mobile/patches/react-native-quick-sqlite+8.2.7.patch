+/*
+** Shutdown all registered SQLite3 Multiple Ciphers VFSs
+*/
+SQLITE_API void sqlite3mc_vfs_shutdown()
+{
+  sqlite3_vfs* pVfs;
+  sqlite3_vfs* pVfsNext;
+  for (pVfs = sqlite3_vfs_find(0); pVfs; pVfs = pVfsNext)
+  {
+    pVfsNext = pVfs->pNext;
+    mcVfsDestroy(pVfs);
+  }
+}
