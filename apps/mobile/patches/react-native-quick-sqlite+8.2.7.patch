+  int c=0;
+  int cc=0;
+  int l=0;
+  const unsigned char *z;       /* input string */
+  const unsigned char *zt;
+  unsigned char *rz;            /* output string */
+
+  assert( argc==2);
+
+  if( SQLITE_NULL==sqlite3_value_type(argv[0]) || SQLITE_NULL==sqlite3_value_type(argv[1])){
