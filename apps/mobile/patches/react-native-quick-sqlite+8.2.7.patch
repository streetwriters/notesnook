+
+struct lxb_dom_node_cb_ctx {
+    lxb_dom_collection_t       *col;
+    lxb_status_t               status;
+    lxb_dom_node_attr_cmp_f    cmp_func;
+
+    lxb_dom_attr_id_t          name_id;
