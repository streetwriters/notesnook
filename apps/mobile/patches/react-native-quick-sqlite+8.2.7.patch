+    STEP(I, c, d, a, b, GET(2),  0x2ad7d2bb, 15)
+    STEP(I, b, c, d, a, GET(9),  0xeb86d391, 21)
+
+    a += saved_a;
+    b += saved_b;
+    c += saved_c;
+    d += saved_d;
+
+    ptr += 64;
+  } while (size -= 64);
+
+  ctx->a = a;
+  ctx->b = b;
+  ctx->c = c;
+  ctx->d = d;
+
+  return ptr;
+}
