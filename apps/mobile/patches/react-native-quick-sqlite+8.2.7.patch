+static void sqliteNaturalKeyFunc(sqlite3_context *context, int argc, sqlite3_value **argv) {
+  if (argc == 0 || sqlite3_value_type(argv[0]) == SQLITE_NULL) {
+    sqlite3_result_null(context);
