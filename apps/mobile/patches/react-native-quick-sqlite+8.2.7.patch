+    if (array->list) {
+        array->length = 0;
+        array->size = 0;
+        array->list = lexbor_free(array->list);
+    }
+
+    if (self_destroy) {
+        return lexbor_free(array);
+    }
+
+    return array;
+}
+
+uint8_t *
+lexbor_array_obj_expand(lexbor_array_obj_t *array, size_t up_to)
