+        return NULL;
+    }
+
+    array->list = list;
+    array->size = new_size;
+
+    return list;
+}
+
+void *
+lexbor_array_obj_push(lexbor_array_obj_t *array)
+{
+    void *entry;
+
+    if (array->length >= array->size)
+    {
+        if ((lexbor_array_obj_expand(array, 128) == NULL)) {
+            return NULL;
+        }
+    }
+
+    entry = array->list + (array->length * array->struct_size);
+    array->length++;
+
+    memset(entry, 0, array->struct_size);
+
+    return entry;
+}
+
+void *
