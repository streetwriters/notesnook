+        }
+
+        status = lxb_url_host_parse(parser, begin, p, &url->host,
+                                    url->mraw, opt);
+        if (status != LXB_STATUS_OK) {
+            lxb_url_parse_return(orig_data, buf, status);
+        }
+
+        if (override_state != LXB_URL_STATE__UNDEF) {
+            lxb_url_parse_return(orig_data, buf, LXB_STATUS_OK);
+        }
+
