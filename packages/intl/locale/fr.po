#: src/strings.ts:417
msgid ""
"Use the following key to format the title:\n"
"\n"
"$date$: Current date.\n"
"$time$: Current time.\n"
"$timestamp$: Full date and time without any spaces or other symbols.\n"
"(e.g 202305261253).\n"
"$count$: Number of notes + 1.\n"
"$headline$: Use starting line of the note as title.\n"
"$day$: Current day (eg. Monday)"
msgstr ""
"Use the following key to format the title:\n"
"\n"
"$date$: Current date.\n"
"$time$: Current time.\n"
"$timestamp$: Full date and time without any spaces or other symbols.\n"
"(e.g 202305261253).\n"
"$count$: Number of notes + 1.\n"
"$headline$: Use starting line of the note as title.\n"
"$day$: Current day (eg. Monday)Utilisez les clés suivantes pour formater le titre :\n"
"\n"
"$date$ : date actuelle.\n"
"$time$ : heure actuelle.\n"
"$timestamp$ : date et heure complètes sans espaces ni autres symboles.\n"
"(p. ex. 202305261253).\n"
"$count$ : nombre de notes + 1.\n"
"$headline$ : utilise la première ligne de la note comme titre.\n"
"$day$ : jour actuel (p. ex. lundi)"

