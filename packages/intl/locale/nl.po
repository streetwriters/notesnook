#: src/strings.ts:417
msgid ""
"Use the following key to format the title:\n"
"\n"
"$date$: Current date.\n"
"$time$: Current time.\n"
"$timestamp$: Full date and time without any spaces or other symbols.\n"
"(e.g 202305261253).\n"
"$count$: Number of notes + 1.\n"
"$headline$: Use starting line of the note as title.\n"
"$day$: Current day (eg. Monday)"
msgstr ""
"Use the following key to format the title:\n"
"\n"
"$date$: Current date.\n"
"$time$: Current time.\n"
"$timestamp$: Full date and time without any spaces or other symbols.\n"
"(e.g 202305261253).\n"
"$count$: Number of notes + 1.\n"
"$headline$: Use starting line of the note as title.\n"
"$day$: Current day (eg. Monday)Gebruik de volgende sleutels om de titel op te maken:\n"
"\n"
"$date$: huidige datum.\n"
"$time$: huidige tijd.\n"
"$timestamp$: volledige datum en tijd zonder spaties of andere symbolen.\n"
"(bijv. 202305261253).\n"
"$count$: aantal notities + 1.\n"
"$headline$: gebruik de eerste regel van de notitie als titel.\n"
"$day$: huidige dag (bijv. maandag)"

