msgid "Your email has been confirmed."
msgstr "Je e-mailadres is bevestigd."

#: src/strings.ts:2264
msgid "Your email has been confirmed. You can now securely sync your encrypted notes across all devices."
msgstr "Je e-mailadres is bevestigd. Je kunt je versleutelde notities nu veilig synchroniseren op al je apparaten."

