#: src/strings.ts:2635
msgid "Your free trial is on-going. Your subscription will start on {trialExpiryDate}"
msgstr "Twój darmowy okres próbny trwa. Subskrypcja rozpocznie się {trialExpiryDate}"

#: src/strings.ts:1778
msgid "Your full name"
msgstr "Twoje imię i nazwisko"

#: src/strings.ts:960
msgid "Your monographs"
msgstr "Twoje monografie"

#: src/strings.ts:1312
msgid "Your name is stored 100% end-to-end encrypted and only visible to you."
msgstr "Twoje imię jest przechowywane w 100% z szyfrowaniem end-to-end i widoczne tylko dla Ciebie."

#: src/strings.ts:560
msgid "Your note will be unencrypted and removed from the vault."
msgstr "Twoja notatka zostanie odszyfrowana i usunięta z sejfu."

#: src/strings.ts:958
msgid "Your notebooks"
msgstr "Twoje notatniki"

#: src/strings.ts:956
msgid "Your notes"
msgstr "Twoje notatki"

#: src/strings.ts:1892
msgid "Your password is always hashed before leaving this device."
msgstr "Twoje hasło jest zawsze haszowane, zanim opuści to urządzenie."

#: src/strings.ts:831
msgid "Your privacy matters to us, no matter who you are. In a world where everyone is trying to spy on you, Notesnook encrypts all your data before it leaves your device. With Notesnook no one can ever sell your data again."
msgstr "Twoja prywatność jest dla nas ważna, kimkolwiek jesteś. W świecie, w którym wszyscy próbują Cię szpiegować, Notesnook szyfruje wszystkie Twoje dane, zanim opuszczą urządzenie. Dzięki Notesnook nikt już nigdy nie sprzeda Twoich danych."

#: src/strings.ts:1309
msgid "Your profile pictrure is stored 100% end-to-end encrypted and only visible to you."
msgstr "Twoje zdjęcie profilowe jest przechowywane w 100% z szyfrowaniem end-to-end i widoczne tylko dla Ciebie."

#: src/strings.ts:1997
msgid "Your refund has been issued. Please wait 24 hours before reaching out to us in case you do not receive your funds."
msgstr "Zwrot został zrealizowany. Jeśli nie otrzymasz środków, odczekaj 24 godziny przed kontaktem z nami."

#: src/strings.ts:959
