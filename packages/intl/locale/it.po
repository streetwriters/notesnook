#: src/strings.ts:373
msgid ""
"Use the following key to format the title:\n"
"\n"
"$date$: Current date.\n"
"$time$: Current time.\n"
"$timestamp$: Full date and time without any spaces or other symbols.\n"
"(e.g 202305261253).\n"
"$count$: Number of notes + 1.\n"
"$headline$: Use starting line of the note as title.\n"
"$day$: Current day (eg. Monday)"
msgstr ""
"Usa le seguenti chiavi per formattare il titolo:\n"
"\n"
"$date$: data corrente.\n"
"$time$: ora corrente.\n"
"$timestamp$: data e ora complete senza spazi o altri simboli.\n"
"(ad es. 202305261253).\n"
"$count$: numero di note + 1.\n"
"$headline$: usa la prima riga della nota come titolo.\n"
"$day$: giorno corrente (ad es. lunedì)"

