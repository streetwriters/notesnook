msgid "Your free trial is on-going. Your subscription will start on {date}."
msgstr "La tua prova gratuita è attiva. Il tuo abbonamento inizierà il {date}."

#: src/strings.ts:2383
msgid "Your free trial is on-going. Your subscription will start on {trialExpiryDate}"
msgstr "La tua prova gratuita è in corso. Il tuo abbonamento inizierà il {trialExpiryDate}"

