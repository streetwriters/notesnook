#: src/strings.ts:373
msgid ""
"Use the following key to format the title:\n"
"\n"
"$date$: Current date.\n"
"$time$: Current time.\n"
"$timestamp$: Full date and time without any spaces or other symbols.\n"
"(e.g 202305261253).\n"
"$count$: Number of notes + 1.\n"
"$headline$: Use starting line of the note as title.\n"
"$day$: Current day (eg. Monday)"
msgstr ""
"Usa las siguientes claves para dar formato al título:\n"
"\n"
"$date$: fecha actual.\n"
"$time$: hora actual.\n"
"$timestamp$: fecha y hora completas sin espacios ni otros símbolos.\n"
"(p. ej., 202305261253).\n"
"$count$: número de notas + 1.\n"
"$headline$: usa la primera línea de la nota como título.\n"
"$day$: día actual (p. ej., lunes)"

