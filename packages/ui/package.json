    "@mdi/js": "7.4.47",
    "@theme-ui/components": "0.16.1",
    "@theme-ui/core": "0.16.1",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@types/react-modal": "3.16.3",
    "mac-scrollbar": "0.13.6",
    "react": "18.3.1",
