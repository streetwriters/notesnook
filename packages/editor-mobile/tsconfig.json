{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true,
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "paths": {
